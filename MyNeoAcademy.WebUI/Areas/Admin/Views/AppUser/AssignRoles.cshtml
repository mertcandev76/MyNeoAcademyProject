@model AssignRolesDTO

@{
    ViewData["Title"] = "Rol Ata";

    var allRoles = ViewBag.AllRoles as List<ResultRoleDTO>;
    var userName = ViewBag.UserName as string ?? "Kullanıcı";
}

<div class="container mt-5">
    <div class="card shadow-sm rounded">
        <div class="card-header">
            <h5 class="mb-0">@userName Kullanıcısına Rol Ata</h5>
        </div>
        <div class="card-body">
            <form asp-action="AssignRoles" asp-route-id="@Model.UserId" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="UserId" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="mb-3">
                    <label class="form-label">Roller</label>

                    @if (allRoles != null && allRoles.Any())
                    {
                        foreach (var role in allRoles)
                        {
                            <div class="form-check">
                                <input class="form-check-input"
                                       type="checkbox"
                                       name="Roles"
                                       value="@role.Name"
                                @(Model.Roles.Contains(role.Name) ? "checked" : "") />
                                <label class="form-check-label">@role.Name</label>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="alert alert-warning">Rol listesi yüklenemedi.</div>
                    }
                </div>

                <div class="d-flex justify-content-between">
                    <button type="submit" class="btn btn-primary">Rolleri Kaydet</button>
                    <a asp-action="Index" asp-area="Admin" class="btn btn-secondary">Geri Dön</a>
                </div>
            </form>
        </div>
    </div>
</div>





