@model CreateCourseEnrollmentDTO
@{
    ViewData["Title"] = "Yeni Kayıt Ekle";
}

<div class="container mt-5">
    <div class="card shadow-sm rounded">
        <div class="card-header">
            <h5 class="mb-0">@ViewData["Title"]</h5>
        </div>

        <div class="card-body">
            <form asp-action="Create" asp-area="Instructor" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="mb-3">
                    <label asp-for="CourseID" class="form-label">Kurs</label>
                    <select asp-for="CourseID" asp-items="(IEnumerable<SelectListItem>)ViewBag.Courses" class="form-control">
                        <option disabled selected hidden>-- Kurs Seçin --</option>
                    </select>
                    <span asp-validation-for="CourseID" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="AppUserID" class="form-label">Öğrenci</label>
                    <select asp-for="AppUserID" asp-items="(IEnumerable<SelectListItem>)ViewBag.Users" class="form-control">
                        <option disabled selected hidden>-- Öğrenci Seçin --</option>
                    </select>
                    <span asp-validation-for="AppUserID" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between">
                    <button type="submit" class="btn btn-success">Kaydet</button>
                    <a asp-action="Index" asp-area="Instructor" class="btn btn-secondary">Geri Dön</a>
                </div>
            </form>
        </div>
    </div>
</div>

