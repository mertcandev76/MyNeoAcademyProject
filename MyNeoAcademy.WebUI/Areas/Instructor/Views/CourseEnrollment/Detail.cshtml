@model ResultCourseEnrollmentDTO

@{
    ViewData["Title"] = "Kayıt Detayı";
}

<div class="container mt-5">
    <div class="card shadow-sm rounded border-primary">
        <div class="card-header">
            <h5 class="mb-0">@ViewData["Title"]</h5>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Kayıt ID</dt>
                <dd class="col-sm-9">@Model.Id</dd>

                <dt class="col-sm-3">Kurs</dt>
                <dd class="col-sm-9">@Model.Course?.Title ?? "<span class='text-muted'>Yok</span>"</dd>

                <dt class="col-sm-3">Öğrenci</dt>
                <dd class="col-sm-9">@Model.AppUser?.FullName ?? "<span class='text-muted'>Yok</span>"</dd>

                <dt class="col-sm-3">Kayıt Tarihi</dt>
                <dd class="col-sm-9">@Model.EnrolledDate.ToString("dd MMMM yyyy")</dd>
            </dl>

            <div class="d-flex justify-content-between">
                <a asp-action="Index" asp-area="Instructor" class="btn btn-secondary">Geri Dön</a>
            </div>
        </div>
    </div>
</div>
