@model CreateCourseWithFileDTO

@{
    ViewData["Title"] = "Yeni Kurs Ekle";
}

<div class="container mt-5">
    <div class="card shadow-sm rounded">
        <div class="card-header">
            <h5 class="mb-0">@ViewData["Title"]</h5>
        </div>

        <div class="card-body">
            <form asp-action="Create" asp-area="Instructor" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label">Kurs Başlığı</label>
                    <input asp-for="Title" class="form-control" placeholder="Kurs başlığını girin..." />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Kurs Açıklaması</label>
                    <textarea asp-for="Description" class="form-control" rows="5" placeholder="Kurs açıklamasını girin..."></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CategoryID" class="font-weight-bold">Kurs Kategorisi</label>
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text bg-light text-secondary">
                                <i class="fas fa-tags"></i>
                            </span>
                        </div>
                        <select asp-for="CategoryID" asp-items="(IEnumerable<SelectListItem>)ViewBag.Categories" class="form-control">
                            <option value="" disabled selected hidden>-- Kategori seçin --</option>
                        </select>
                    </div>
                    <span asp-validation-for="CategoryID" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Price" class="form-label">Fiyat (TL)</label>
                    <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" placeholder="Fiyat girin..." />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ImageFile" class="form-label">Kurs Görseli</label>
                    <input asp-for="ImageFile" type="file" class="form-control" accept=".jpg,.jpeg,.png" />
                    <span asp-validation-for="ImageFile" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between">
                    <button type="submit" class="btn btn-success">Kaydet</button>
                    <a asp-action="MyCourses" asp-area="Instructor" class="btn btn-secondary">Geri Dön</a>
                </div>
            </form>
        </div>
    </div>
</div>
