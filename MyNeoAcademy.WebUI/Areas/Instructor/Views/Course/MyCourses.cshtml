@model List<ResultCourseDTO>

@{
    ViewData["Title"] = "Kurslarım";
}

<div class="container-fluid px-3">
    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h3 class="mb-0">@ViewData["Title"]</h3>
        </div>
        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <table class="table table-bordered mb-0 text-center align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Başlık</th>
                            <th>Kategori</th>
                            <th>Öğrenci Sayısı</th>
                            <th>Fiyat</th>
                            <th style="width: 150px;">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (course, index) in Model.Select((value, i) => (value: value, i)))
                        {
                            <tr>
                                <td>@(index + 1)</td>
                                <td>@course.Title</td>
                                <td>@course.Category?.Name ?? "Kategori Yok"</td>
                                <td>@course.StudentCount</td>
                                <td>@(course.Price.HasValue ? course.Price.Value.ToString("C") : "Ücretsiz")</td>
                                <td>
                                    <a asp-action="Detail" asp-route-id="@course.CourseID" class="btn btn-primary btn-sm me-1" title="Detay">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@course.CourseID" class="btn btn-warning btn-sm me-1" title="Düzenle">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <button type="button"
                                            class="btn btn-danger btn-sm"
                                            data-toggle="modal"
                                            data-target="#deleteModal"
                                            data-id="@course.CourseID"
                                            data-name="@course.Title"
                                            data-controller="Course"
                                            data-area="Instructor"
                                            title="Sil">
                                        <i class="fas fa-trash"></i>
                                    </button>

                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="alert alert-warning m-3 text-center">
                    Henüz oluşturulmuş kurs bulunmamaktadır.
                </div>
            }
        </div>
    </div>
</div>

@await Html.PartialAsync("_DeleteModalPartial")





