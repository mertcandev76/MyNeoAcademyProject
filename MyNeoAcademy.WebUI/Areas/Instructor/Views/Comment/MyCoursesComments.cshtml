        </div>

        <div class="card-body p-0">
            @if (Model.Comments != null && Model.Comments.Any())
            {
                <table class="table table-striped table-bordered mb-0 text-center align-middle">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 5%;">#</th>
                            <th style="width: 20%;">Kullanıcı</th>
                            <th style="width: 50%;">İçerik</th>
                            <th style="width: 10%;">Puan</th>
                            <th style="width: 15%;">Oluşturulma Tarihi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var comment in Model.Comments)
                        {
                            <tr>
                                <td>@comment.CommentID</td>
                                <td>@comment.UserName</td>
                                <td class="text-start">@comment.Content</td>
                                <td>@comment.Rating</td>
                                <td>@comment.CreatedDate.ToString("dd.MM.yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="alert alert-warning m-3 text-center">
                    Henüz yorum bulunmamaktadır.
                </div>
            }
        </div>
    </div>
</div>



