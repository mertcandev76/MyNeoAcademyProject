@{
    Layout = null;
}

<!DOCTYPE html>
<html dir="ltr" lang="en">


@await Component.InvokeAsync("CommonHead")

<body>
    <!-- Preloader - style you can find in spinners.css -->
    <div class="preloader">
        <div class="lds-ripple">
            <div class="lds-pos"></div>
            <div class="lds-pos"></div>
        </div>
    </div>
    <!-- End Preloader - style you can find in spinners.css -->
    <!-- Main wrapper - style you can find in pages.scss -->
    <!-- ============================================================== -->
    <div id="main-wrapper">

        <!-- Topbar header - style you can find in pages.scss -->
        @await Component.InvokeAsync("CommonHeader")
        <!-- End Topbar header -->
        <!-- Left Sidebar - style you can find in sidebar.scss  -->
        @await Component.InvokeAsync("InstructorSidebar")
        <!-- End Left Sidebar - style you can find in sidebar.scss  -->
        <!-- Page wrapper  -->
        <div class="page-wrapper">

            <!-- Bread crumb and right sidebar toggle -->
            @await Component.InvokeAsync("CommonRightSidebar")
            <!-- End Bread crumb and right sidebar toggle -->
            <!-- Container fluid  -->
            <div class="container-fluid">
                @RenderBody()
            </div>
            <!-- End Container fluid  -->
            <!-- footer -->
            @await Component.InvokeAsync("CommonFooter")
            <!-- End footer -->

        </div>
        <!-- End Page wrapper  -->
    </div>
    <!-- End Wrapper -->
    <!-- All Jquery -->
    @await Component.InvokeAsync("CommonScripts")
    <!-- End Jquery -->

</body>

</html>

